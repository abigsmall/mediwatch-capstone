FROM apache/airflow:2.11.2-python3.12

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
USER airflow

COPY requirements-airflow.txt /opt/airflow/requirements-airflow.txt
RUN uv pip install --no-cache-dir -r /opt/airflow/requirements-airflow.txt
